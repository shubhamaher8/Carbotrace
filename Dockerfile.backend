FROM python:3.11-slim

# Install git and system packages for building (e.g. tree-sitter grammars might need gcc/g++ if they aren't pre-compiled, though tree-sitter-languages usually has wheel)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements
COPY backend/requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Create temp clone directory
RUN mkdir -p /app/backend/temp_repos

# Copy app code
COPY backend /app/backend

# Copy startup script
COPY backend/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Set python path to allow importing backend.app.main
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["/app/start.sh"]
